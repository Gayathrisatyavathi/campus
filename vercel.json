      "destination": "/frontend/placements.html"
    },
    {
      "source": "/companies",
      "destination": "/frontend/companies.html"
    },
    {
      "source": "/jobs",
      "destination": "/frontend/jobs.html"
    },
    {
      "source": "/ai-skills",
      "destination": "/frontend/ai-skills.html"
    },
    {
      "source": "/training",
      "destination": "/frontend/training.html"
    },
    {
      "source": "/courses",
      "destination": "/frontend/courses.html"
    },
    {
      "source": "/interviews",
      "destination": "/frontend/interviews.html"
    },
    {
      "source": "/tests",
      "destination": "/frontend/tests.html"
    },
    {
      "source": "/achievements",
      "destination": "/frontend/achievements.html"
    },
    {
      "source": "/admin",
      "destination": "/frontend/admin.html"
